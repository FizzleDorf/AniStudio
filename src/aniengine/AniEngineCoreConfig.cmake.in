@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find required dependencies
find_dependency(OpenCV REQUIRED)
find_dependency(Vulkan REQUIRED)
find_dependency(glew REQUIRED)
find_dependency(glfw3 REQUIRED)
find_dependency(ZLIB REQUIRED)
find_dependency(PNG REQUIRED)
find_dependency(FFmpeg REQUIRED)
find_dependency(pybind11 REQUIRED)
find_dependency(semver REQUIRED)

# CUDA support (optional)
if(@ANIENGINE_ENABLE_CUDA@)
    find_dependency(CUDAToolkit REQUIRED)
endif()

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/AniEngineCoreTargets.cmake")

check_required_components(AniEngineCore)

# Provide version information
set(AniEngineCore_VERSION @PROJECT_VERSION@)
set(AniEngineCore_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(AniEngineCore_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(AniEngineCore_VERSION_PATCH @PROJECT_VERSION_PATCH@)