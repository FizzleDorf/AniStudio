@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find all required dependencies for AniEngineCore
find_dependency(Vulkan REQUIRED)
find_dependency(OpenCV REQUIRED)
find_dependency(pybind11 REQUIRED)
find_dependency(ZLIB REQUIRED)
find_dependency(PNG REQUIRED)
find_dependency(exiv2 REQUIRED)
find_dependency(FFmpeg REQUIRED)

if(@SD_CUDA@)
    find_dependency(CUDAToolkit REQUIRED)
endif()

# Include the exported targets
include("${CMAKE_CURRENT_LIST_DIR}/AniEngineCoreTargets.cmake")

check_required_components(AniEngineCore)