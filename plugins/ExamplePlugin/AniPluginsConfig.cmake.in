@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find AniEngineCore dependency
find_dependency(AniEngineCore REQUIRED)

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/AniPluginsTargets.cmake")

check_required_components(AniPlugins)

# Provide version information
set(AniPlugins_VERSION @PROJECT_VERSION@)
set(AniPlugins_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(AniPlugins_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(AniPlugins_VERSION_PATCH @PROJECT_VERSION_PATCH@)

# Utility function for creating plugins
function(add_anistudio_plugin TARGET_NAME)
    cmake_parse_arguments(PLUGIN "" "" "SOURCES;LIBRARIES;INCLUDE_DIRS" ${ARGN})
    
    add_library(${TARGET_NAME} SHARED ${PLUGIN_SOURCES})
    
    target_include_directories(${TARGET_NAME} PRIVATE
        ${PLUGIN_INCLUDE_DIRS}
    )
    
    target_link_libraries(${TARGET_NAME} PRIVATE
        AniPlugins::AniPlugins
        ${PLUGIN_LIBRARIES}
    )
    
    target_compile_definitions(${TARGET_NAME} PRIVATE
        PLUGIN_API=__declspec\(dllexport\)
    )
    
    set_target_properties(${TARGET_NAME} PROPERTIES
        CXX_STANDARD 17
        CXX_STANDARD_REQUIRED ON
        CXX_EXTENSIONS OFF
    )
    
    message(STATUS "Added AniStudio plugin: ${TARGET_NAME}")
endfunction()